<Window x:Class="HciMac.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CAV-MAC - Multimodal Access Control" Height="1120" Width="1120"
        Background="#141A24" FontFamily="Segoe UI">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1E2632" Padding="14,10">
      <StackPanel>
        <TextBlock Text="Multimodal Access Control" Foreground="#EAF1FB" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="InstructionText" Text="Starting..."
                   Foreground="#9FB0C6" FontSize="13" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#1E2632" Padding="12,8">
      <DockPanel>
        <Button x:Name="StartButton" DockPanel.Dock="Left" Content="Start" Width="110" Height="40"
                FontSize="15" Margin="0,0,12,0" IsEnabled="False" Click="StartButton_Click"/>
        <Border x:Name="ResultBorder" DockPanel.Dock="Right" CornerRadius="6" Padding="16,8"
                VerticalAlignment="Center" Background="#0F1620" Visibility="Collapsed">
          <TextBlock x:Name="ResultText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock x:Name="StatusText" Foreground="#9FB0C6" FontSize="12"/>
          <TextBlock x:Name="FaceStatus"  Foreground="#7f8ea3" FontSize="11" Margin="0,2,0,0"/>
          <TextBlock x:Name="VoiceStatus" Foreground="#7f8ea3" FontSize="11"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <wv2:WebView2 x:Name="Web"/>
  </DockPanel>
</Window>
