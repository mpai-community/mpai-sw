<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AcrApp</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DefineConstants>$(DefineConstants);WINDOWS_DEVICES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <!-- Framework -->
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.GlobalStorage\AIF.GlobalStorage.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Gallery\Mpai.Gallery.csproj" />
    <!-- The Human-CAV Interaction avatar surface (WebView renderer + present) -->
    <ProjectReference Include="..\..\..\..\UAs\Lib\UaKit\Mpai.UaKit.csproj" />
    <!-- The HCI API -->
    <ProjectReference Include="..\..\..\..\MW\HciApi\Mpai.Hci.Api.csproj" />
    <!-- Description AIMs (kept) -->
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\EFD\Mpai.Paf.Efd.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\ESD\Mpai.Mmc.Esd.csproj" />
    <!-- Reconciliation: the reused fusion (HCI-IDR) + the new OSD-IDR (verdict + Personal Status) -->
    <ProjectReference Include="..\..\..\..\AIMs\HCI\IDR\Mpai.Hci.Idr.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\OSD\V1.5\IDR\Mpai.Osd.Idr.csproj" />
    <!-- Recognition AIMs (CAV-MAC leaves) -->
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\FIR\Mpai.Paf.Fir.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\SIR\Mpai.Mmc.Sir.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\OSD\V1.5\VisualScene\Mpai.Osd.VisualScene.csproj" />
    <!-- Response and Scene Rendering leaves (PAF-RSR = PSD + TTS + GFD) -->
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\PSD\Mpai.Paf.Psd.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\GFD\Mpai.Paf.Gfd.csproj" />
