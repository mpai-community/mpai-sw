<Window x:Class="AcrApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="HCI-ACR - Access Control Registration" Height="1120" Width="1120"
        Background="#141A24" FontFamily="Segoe UI">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1E2632" Padding="14,10">
      <StackPanel>
        <TextBlock Text="Access Control Registration" Foreground="#EAF1FB" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="InstructionText" Text="Starting..."
                   Foreground="#9FB0C6" FontSize="13" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#1E2632" Padding="12,8">
      <StackPanel>
        <!-- Typed-name fallback: hidden until ASR fails to catch the spoken name -->
        <DockPanel x:Name="NamePanel" Visibility="Collapsed" Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Left" Text="Type your name:" Foreground="#EAF1FB"
                     FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="ConfirmNameButton" DockPanel.Dock="Right" Content="Confirm" Width="100" Height="34"
                  FontSize="14" Margin="10,0,0,0" Click="ConfirmName_Click"/>
          <TextBox x:Name="NameBox" Height="34" FontSize="15" VerticalContentAlignment="Center"
                   KeyDown="NameBox_KeyDown"/>
        </DockPanel>
        <DockPanel>
          <Button x:Name="StartButton" DockPanel.Dock="Left" Content="Register" Width="120" Height="40"
                  FontSize="15" Margin="0,0,12,0" IsEnabled="False" Click="StartButton_Click"/>
          <StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#9FB0C6" FontSize="12"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    <wv2:WebView2 x:Name="Web"/>
  </DockPanel>
</Window>
