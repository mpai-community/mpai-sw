<Project Sdk="Microsoft.NET.Sdk">

  <!-- MadServer - MMC-MAD behind the MPAI-MAS API.
       THE SECOND APPLICATION ON THE SAME LAYER. Nothing in Mpai.Mas.Server,
       Mpai.Mas.PortData or Mpai.Mas.Client changed to accommodate it: the
       server knows Data Types and no application, so a second one contributes
       a provider and a list of Modules and nothing else.

       MadProvider is COMPILED IN rather than referenced, as AmqProvider is for
       AmqServer: it is internal to MadApp, and linking the source leaves that
       file untouched. -->

  <PropertyGroup>
    <AssemblyName>MadServer</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MmcMad.Server</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="NorthApiRunner.cs" />
    <Compile Include="MasServerConfig.cs" />
    <Compile Include="..\..\MadApp\src\MadProvider.cs" Link="MadProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.GlobalStorage\AIF.GlobalStorage.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\MW\HciApi\Mpai.Hci.Api.csproj" />
    <ProjectReference Include="..\..\..\..\MW\MasServer\Mpai.Mas.Server.csproj" />
    <ProjectReference Include="..\..\..\..\MW\PortData\Mpai.Mas.PortData.csproj" />

    <!-- MMC-MAD leaves, plus the RSR leaves so the avatar can speak. No device
         project: acquisition and delivery are the User Agent's and travel with
         the client. -->
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\ASR\Mpai.Mmc.Asr.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\EDP\Mpai.Mmc.Edp.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\TTS\Mpai.Mmc.Tts.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\PSD\Mpai.Paf.Psd.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\PAF\V1.6\GFD\Mpai.Paf.Gfd.csproj" />
  </ItemGroup>

</Project>