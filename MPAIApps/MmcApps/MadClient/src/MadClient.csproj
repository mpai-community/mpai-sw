<Project Sdk="Microsoft.NET.Sdk">

  <!-- MadClient - Multimodal Anonymous Dialogue, across a network.

       ITS OWN SOURCES. MAD and its client are different applications for
       different users: one runs a Module in process, the other drives one over
       MPAI-MAS and holds no model and no Framework. They were one source with a
       compilation switch, which meant the standalone application carried the
       networked path it never used.

       EnableDefaultItems is false, so every item is named here. -->

  <PropertyGroup>
    <AssemblyName>MadClient</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DefineConstants>$(DefineConstants);WINDOWS_DEVICES</DefineConstants>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="Program.cs" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\UAs\Lib\UaKit\Mpai.UaKit.csproj" />
    <ProjectReference Include="..\..\..\..\MW\HciApi\Mpai.Hci.Api.csproj" />
    <ProjectReference Include="..\..\..\..\MW\MasClient\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\CAE3\V1.0\AOA\Mpai.Cae.Aoa.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\CAE3\V1.0\AOA.Windows\Mpai.Cae.Aoa.Windows.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\SOD\Mpai.Mmc.Sod.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\SOD.Windows\Mpai.Mmc.Sod.Windows.csproj" />
  </ItemGroup>

</Project>