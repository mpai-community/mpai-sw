    <ApplicationDefinition Include="..\..\MadApp\src\App.xaml" Link="App.xaml" />
    <Page Include="..\..\MadApp\src\MainWindow.xaml" Link="MainWindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
