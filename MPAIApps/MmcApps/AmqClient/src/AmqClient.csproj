<Project Sdk="Microsoft.NET.Sdk">

  <!-- AmqClient - the Remote Client Application package.
       THE SAME SOURCES AS AmqApp, MINUS THE MODELS. A client driving a Module
       over MPAI-MAS holds no models, loads no AIM and reads no
       aim-settings.json. AmqProvider.cs and every AIM reference are absent, so
       this package physically cannot load a model. About 150 MB smaller,
       nearly all of it ONNX Runtime natives a client never opens.

       THE SOURCES ARE LINKED, NOT COPIED. A copied window drifts from its
       original. REMOTE_ONLY compiles out the in-process branch. -->

  <PropertyGroup>
    <AssemblyName>AmqClient</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DefineConstants>$(DefineConstants);WINDOWS_DEVICES;REMOTE_ONLY</DefineConstants>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\AmqApp\src\MainWindow.xaml.cs" Link="MainWindow.xaml.cs" />
    <Compile Include="..\..\AmqApp\src\App.xaml.cs"        Link="App.xaml.cs" />
    <Compile Include="..\..\AmqApp\src\Program.cs"         Link="Program.cs" />
    <ApplicationDefinition Include="..\..\AmqApp\src\App.xaml" Link="App.xaml" />
    <Page Include="..\..\AmqApp\src\MainWindow.xaml"          Link="MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\V3.0\src\AIF.Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\UAs\Lib\UaKit\Mpai.UaKit.csproj" />
    <ProjectReference Include="..\..\..\..\MW\HciApi\Mpai.Hci.Api.csproj" />
    <ProjectReference Include="..\..\..\..\MW\MasClient\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\CAE3\V1.0\AOA\Mpai.Cae.Aoa.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\CAE3\V1.0\AOA.Windows\Mpai.Cae.Aoa.Windows.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\SOD\Mpai.Mmc.Sod.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\MMC\V2.5\SOD.Windows\Mpai.Mmc.Sod.Windows.csproj" />
  </ItemGroup>

</Project>