<Window x:Class="MmcAmq.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MMC-AMQ - Answer to Multimodal Question" Height="720" Width="1100">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="420"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="InstructionText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Text="Wait while the avatar loads" FontSize="16" Margin="0,0,0,8"/>

    <!-- left: the image -->
    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Margin="0,0,8,0">
      <Image x:Name="ImageView" Stretch="Uniform"/>
    </Border>

    <!-- right: the avatar (speaks the answer) -->
    <wv2:WebView2 x:Name="Web" Grid.Row="1" Grid.Column="1"/>

    <!-- question row -->
    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="LoadButton" Grid.Column="0" Content="Load Image..." Padding="10,4" Margin="0,0,8,0" Click="LoadButton_Click"/>
      <TextBox x:Name="QuestionBox" Grid.Column="1" FontSize="14" VerticalContentAlignment="Center" Padding="6,2"/>
      <Button x:Name="SpeakButton" Grid.Column="2" Content="Speak Question" Padding="10,4" Margin="8,0,0,0" Click="SpeakButton_Click" IsEnabled="False"/>
      <Button x:Name="AskButton" Grid.Column="3" Content="Ask" Padding="16,4" Margin="8,0,0,0" Click="AskButton_Click" IsEnabled="False"/>
    </Grid>

    <!-- answer -->
    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#CCC" BorderThickness="1" Margin="0,8,0,0" Padding="8">
      <StackPanel>
        <TextBlock Text="Answer:" FontWeight="Bold"/>
        <TextBlock x:Name="AnswerText" TextWrapping="Wrap" FontSize="15" Margin="0,4,0,0"/>
        <TextBlock x:Name="StatusText" Foreground="#888" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
