<Project Sdk="Microsoft.NET.Sdk">

  <!-- RcaApp - a Remote Client Application with a face.
       The same interpreter as RcaConsole, with the stand-in devices replaced by
       the real ones: a microphone, a webcam and the avatar. It knows no
       application. Which Modules run, which Ports they take and which they give,
       all come from the Workflow Description it is given.

       IT HOLDS NO MODEL. Acquisition and delivery are the User Agent's, so the
       AIMs that touch a device travel with it; everything that reasons stays on
       the Service. -->

  <PropertyGroup>
    <AssemblyName>RcaApp</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DefineConstants>$(DefineConstants);WINDOWS_DEVICES</DefineConstants>
    <RootNamespace>MpaiRca</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MW\Rca\Mpai.Rca.csproj" />
    <ProjectReference Include="..\..\..\MW\Wdl\Mpai.Wdl.csproj" />
    <ProjectReference Include="..\..\..\MW\HciApi\Mpai.Hci.Api.csproj" />
    <ProjectReference Include="..\..\..\MW\MasClient\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\UAs\Lib\UaKit\Mpai.UaKit.csproj" />

    <!-- The devices. Acquisition and delivery are the User Agent's and travel
         with it; nothing here reasons about what it captures. -->
    <ProjectReference Include="..\..\..\AIMs\CAE3\V1.0\AOA\Mpai.Cae.Aoa.csproj" />
    <ProjectReference Include="..\..\..\AIMs\CAE3\V1.0\AOA.Windows\Mpai.Cae.Aoa.Windows.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\SOD\Mpai.Mmc.Sod.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\SOD.Windows\Mpai.Mmc.Sod.Windows.csproj" />
    <ProjectReference Include="..\..\..\AIMs\CVE\V1.0\VOA\Mpai.Cve.Voa.csproj" />
    <ProjectReference Include="..\..\..\AIMs\CVE\V1.0\VOA.Windows\Mpai.Cve.Voa.Windows.csproj" />
  </ItemGroup>

</Project>