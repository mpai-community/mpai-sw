<Window x:Class="MpaiRca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MPAI Remote Client Application" Height="880" Width="660" SizeToContent="Width"
        Background="#101014">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="WorkflowText" Grid.Row="0" Foreground="#8899AA"
               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
               Margin="0,0,0,8" Text="no Service"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="AvatarColumn" Width="640"/>
        <ColumnDefinition x:Name="AppColumn" Width="0"/>
        <ColumnDefinition x:Name="StageColumn" Width="0"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Background="Black">
        <wv2:WebView2 x:Name="Web"/>
      </Border>

      <Border x:Name="AppPanel" Grid.Column="1" CornerRadius="8" Background="#12161C" Margin="12,0,0,0" Visibility="Collapsed"
              >
        <DockPanel Margin="18">
          <TextBlock DockPanel.Dock="Top" Foreground="#EAF1FB" FontSize="19"
                     FontWeight="SemiBold" Text="Choose an application"
                     Margin="0,0,0,4"/>
          <TextBlock x:Name="AppPanelHint" DockPanel.Dock="Top" Foreground="#8899AA"
                     FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                     Text="These are offered by the Service. This client holds none of them."/>
          <ListBox x:Name="AppList" SelectionChanged="AppList_SelectionChanged" Background="Transparent" BorderThickness="0"
                   Foreground="#DDDDDD" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#1A2029" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                  <DockPanel>
                    <Image DockPanel.Dock="Right" Source="{Binding Icon}" Width="40" Height="40"
                           Margin="12,0,0,0" VerticalAlignment="Top"/>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Foreground="#EAF1FB"
                                 FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Description}" Foreground="#9FB0C6"
                                 FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- WHAT THE APP IS WORKING WITH. A picture chosen, a document read:
           acquired and shown, so that a person can see what they gave. -->
      <Border x:Name="StagePanel" Grid.Column="2" CornerRadius="8" Background="#12161C" Margin="12,0,0,0" Visibility="Collapsed">
        <DockPanel Margin="14">
          <TextBlock DockPanel.Dock="Top" x:Name="StageTitle" Foreground="#EAF1FB"
                     FontSize="15" FontWeight="SemiBold" Text="No image displayed"
                     Margin="0,0,0,10"/>
          <TextBlock DockPanel.Dock="Bottom" x:Name="StageText" Foreground="#9FB0C6"
                     FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <Border Background="#0A0D11" CornerRadius="6">
            <Image x:Name="StageImage" Stretch="Uniform" Margin="6"/>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock x:Name="InstructionText" Grid.Row="2" Foreground="#DDDDDD"
               FontSize="16" TextWrapping="Wrap" Margin="0,12,0,8"
               Text="Wait while the avatar loads"/>

    <DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="True">
      <Button DockPanel.Dock="Left" x:Name="StopButton"  Content="Stop"         Width="90"  Height="30" Margin="0,0,8,0" IsEnabled="False"
              VerticalAlignment="Top"/>
      <!-- Enter comes before the text box so that the text box, last, takes all the room left. -->
      <Button DockPanel.Dock="Right" x:Name="SendButton"  Content="Enter"        Width="70"  Height="30" IsEnabled="False"
              VerticalAlignment="Top"/>
      <TextBox x:Name="TypedBox"   Height="64" VerticalContentAlignment="Top"
               TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
               FontSize="14" Margin="8,0,8,0" IsEnabled="False"
               HorizontalAlignment="Stretch"/>
    </DockPanel>

    <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="#667788"
               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Text="ready"/>
  </Grid>
</Window>