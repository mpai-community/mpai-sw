    { "Name": "BrakeResponse"   , "Direction": "Input"  , "DataType": "CAV-BRR-V2.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "MotorResponse"   , "Direction": "Input"  , "DataType": "CAV-MRP-V2.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "WheelResponse"   , "Direction": "Input"  , "DataType": "CAV-WHR-V2.0", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "RoadState"       , "Direction": "Input"  , "DataType": "CAV-RDS-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "AMSMASMessageOut", "Direction": "Output" , "DataType": "CAV-AMM-V2.0",  "Technology": "Software", "Protocol": "", "IsRemote": false }
  ],

  "SubAIMs":  [ ],

  "Topology":  [ ],

