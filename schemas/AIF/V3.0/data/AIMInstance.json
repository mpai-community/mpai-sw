{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/AIF/V3.0/data/AIMInstance.json",
  "title":                "AIM Instance V3.0",
  "type":                 "object",
  "required":             [ "Header", "AIMInstanceID", "AIMInstance" ],
  "additionalProperties": false,  
  "properties":           {

    "Header":             { "type": "string", "const": "AIF-AMI-V3.0" },
    "AIMInstanceID":      { "type": "string" },

    "AIMInstance":        { "type": "array", "minItems": 1, "items": { "oneOf": [
                          { "type": "object", "required": [ "AIMType" ], "additionalProperties": false, "properties": {
      "AIMType":          { "$ref": "#/$defs/AIMType" } } },
                          { "type": "object", "required": [ "AIMID" ], "additionalProperties": false, "properties": {
      "AIMID":            { "type": "string" } } },
                          { "type": "object", "required": [ "ImplementerAIMID" ], "additionalProperties": false, "properties": {
      "ImplementerAIMID": { "type": "string" } } } ] } },

    "DataXMData":         { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":      { "type": "string", "maxLength": 2048 } },

  "$defs":                {
    "AIMType":            { "type": "string", "pattern": "^[A-Z]{3}-[A-Z]{3}-V[0-9]{1,2}[.][0-9]{1,2}$",
                            "description": "The AIM Type as a Standard names it, e.g. MMC-MAD-V2.5." },
    "AIMInstanceIdentifier": { "type": "string", "pattern": "^[0-9A-Za-z]+[A-Z]{3}-[A-Z]{3}-V[0-9]{1,2}[.][0-9]{1,2}-I[0-9]+$",
                            "description": "An AIM Instance identifier: the ImplementerID, the AIM Type and -I with the Instance number, e.g. 1MMC-MAD-V2.5-I01." } } }
