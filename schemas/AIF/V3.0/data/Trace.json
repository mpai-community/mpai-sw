{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/AIF/V3.0/data/Trace.json",
  "title":                "Trace V3.0",
  "type":                 "object",
  "required":             [ "Header", "TraceID" ],
  "additionalProperties": false,
  "properties":           {

    "Header":             { "type": "string", "const": "AIF-TRC-V3.0" },
    "MInstance":          { "type": "string" },
    "UEnvironment":       { "type": "string" },
    "TraceID":            { "type": "string" },
    "TraceTime":          { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Source":             { "type": "array", "items": { "oneOf": [
                          { "type": "object", "required": [ "AIMInstance" ], "additionalProperties": false, "properties": {
      "AIMInstance":      { "$ref": "https://schemas.mpai.community/AIF/V3.0/data/AIMInstance.json" } } },
                          { "type": "object", "required": [ "ProcessID" ],   "additionalProperties": false, "properties": {
      "ProcessID":        { "type": "string" } } } ] } },
    "Time":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Sequence":           { "type": "integer", "minimum": 1,
                            "description": "The place of this record in a chained Trace (a Controller's Trace of its trust decisions): 1 for the first." },
    "Previous":           { "type": "object", "required": [ "HashAlgorithm", "Hash" ], "additionalProperties": false,
                            "description": "In a chained Trace: the hash of the canonical form (PTF-JSON-CANON-V1) of the record before this one - of the Trust Anchor object of the Source, for the first. A record removed, reordered, inserted or changed breaks the chain where it is.",
                            "properties": {
      "HashAlgorithm":    { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/SecurityAlgorithmTaxonomy.json#/properties/Hash" },
      "Hash":             { "type": "string", "pattern": "^([0-9A-F]{2})+$" } } },
    "TrustOperation":     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/TrustOperation.json",
                            "description": "The trust decision this record traces." },

    "DescrMetadata":      { "type": "string", "maxLength": 2048 },
    "Signature":          { "type": "string", "pattern": "^([0-9A-F]{2})+$",
                            "description": "Hexadecimal signature over the canonical form (PTF-JSON-CANON-V1) of the record without its Signature, by the key KeyID names: the Source's." },
    "KeyID":              { "type": "string" } },
  "dependentRequired":    { "Sequence": [ "Previous", "Signature" ], "Previous": [ "Sequence" ], "Signature": [ "KeyID" ] } }
