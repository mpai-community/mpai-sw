{ "$schema":                                "https://json-schema.org/draft/2020-12/schema",
  "$id":                                    "https://schemas.mpai.community/OSD/V1.5/data/BasicOfflineMapSceneDescriptors.json",
  "title":                                  "Basic OfflineMap Scene Descriptors V1.5",
  "type":                                   "object",
  "additionalProperties":                   false,
  "required":                               [ "Header", "MInstanceID", "BasicOfflineMapSceneDescriptorsID", "BOMSceneDescriptorsSpaceTime",
                                            	"ObjectCount", "BasicOfflineMapSceneDescriptors" ],
  "properties": {

    "Header":                               { "type": "string", "const": "OSD-BOS-V1.5" },
    "MInstanceID":                          { "type": "string" },
    "UEnvironmentID":                       { "type": "string" },
    "BasicOfflineMapSceneDescriptorsID":    { "type": "string" },
    "BOMSceneDescriptorsSpaceTime":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },

    "ObjectCount":                          { "type": "integer", "minimum": 0 },

    "BasicOfflineMapSceneDescriptors":      { "type": "array", "minItems": 0, "items": { "type": "object",
                                              "additionalProperties": false, "required": [ "ObjectIDOrObject" ], "properties": {
      "ObjectSpaceTime":                    { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpaceTime.json" },
      "ObjectIDOrObject":                   { "type": "array", "minItems": 1, "maxItems": 1, "items": { "oneOf": [
                                            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/OfflineMapObject.json" },
                                            { "type": "string" } ] } } } } },

    "DataXMData":                           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                        { "type": "string", "maxLength": 2048 } } }