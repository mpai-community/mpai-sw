{ "$schema":            "https://json-schema.org/draft/2020-12/schema",
  "$id":                "https://schemas.mpai.community/OSD/V1.5/data/OcclusionFlag.json",
  "title":              "Occlusion Flag V1.5",
  "type":               "object",
  "required":           ["Header", "OcclusionStatus" ],
  "properties":         {

    "Header":           { "type": "string", "const": "OSD-OFL-V1.5" },
    "MInstanceID":      { "type": "string" },
    "UEnvironmentID":   { "type": "string" },
    "OcclusionFlagID":  { "type": "string" },
    "PathTime":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "OcclusionStatus":  { "type": "string", "description": "Visibility or occlusion state of an object from a given PoV.",
                          "enum": ["Visible", "PartiallyOccluded", "FullyOccluded"] },

    "DataXMData":       { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":    { "type": "string", "maxLength": 2048 } } }