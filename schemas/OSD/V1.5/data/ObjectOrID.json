    "SpeechObjectOrID":   { "anyOf": [ { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/BasicSpeechObject.json" }, { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SpeechObject.json" },  { "type": "string" } ] },
    "VisualObjectOrID":   { "oneOf": [ { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/VisualObject.json" },  { "type": "string" } ] } } }