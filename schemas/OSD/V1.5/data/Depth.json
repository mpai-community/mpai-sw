  "title":                    "Depth V1.5", "type": "object", "required": [ "Header", "DepthValue" ], "properties": {

    "Header":                 { "type": "string", "const": "OSD-DPT-V1.5" },
    "MInstanceID":            { "type": "string" },

    "DepthValue":             { "description": "Estimated distance from PointOfView origin in meters", "type": "number", "minimum": 0 },
