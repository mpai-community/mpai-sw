{ "Identifier":       {"ImplementerID": "IIDRA-assigned", "ImplementationID": "/* String from Implementer */", "AIMName": "PAF-RSR-V1.6"},
  "Header":            "PAF-RSR-V1.6",

  "APIProfile":       "Basic",
  "Description":      "Response and Scene Rendering: renders the machine's response as a Speaking Avatar. When a Personal Status is supplied, Personal Status De-multiplexing splits it into a Speech Personal Status, a Face Personal Status and a Body Personal Status that make the speech, face and body expressive; when the Personal Status is absent the avatar renders neutrally. Text-To-Speech renders the Machine Speech from a Text Object; the face description branch produces the Machine Face Descriptors and the body description branch produces the Machine Body Descriptors, each from a Text Object and the Machine Speech. A composite AIM assembled by the Modules that speak; it is a component AIM, not itself a Module.",

  "InternalTypes":   [{"Name": "SpeechPersonalStatus",   "DataType": "MMC-SPS-V2.5"},
                     {"Name": "FacePersonalStatus",     "DataType": "MMC-FPS-V2.5"},
