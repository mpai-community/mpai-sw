  "$id":                  "https://schemas.mpai.community/PAF/V1.6/AIMs/SpeakingAvatarSynthesis.json",
  "title":                "Speaking Avatar Synthesis V1.6",

  "Identifier":           {"ImplementerID": "/* String assigned by IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "PAF-SAS-V1.6"},
  "Header":               "PAF-SAS-V1.6",

  "APIProfile":           "Basic",
  "Description":          "Speaking Avatar Synthesis: makes a Speaking Avatar of the input Avatar - its 3D Model animated by the Face Descriptors and the Body Descriptors, uttering the Speech. The Speaking Avatar is ready to play: the Avatar it holds carries the Model, the Speech and the Face and Body Descriptors, time-aligned. The Avatar is kept: given once - when the Module starts, or when the User Agent changes avatar - it is used for every utterance until another arrives.",

  "ExternalPorts":        [{"Name": "Avatar",                "Direction": "Input",  "DataType": "PAF-AVT-V1.6", "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "SpeechObject",          "Direction": "Input",  "DataType": ["OSD-BSO-V1.5", "OSD-SPO-V1.5"], "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "FaceDescriptorsObject", "Direction": "Input",  "DataType": "PAF-FDO-V1.6", "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "BodyDescriptorsObject", "Direction": "Input",  "DataType": "PAF-BDO-V1.6", "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "SpeakingAvatar",        "Direction": "Output", "DataType": "XRV-SAV-V1.0", "Technology": "Software", "Protocol": "", "IsRemote": false}],

