{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$id":                  "https://schemas.mpai.community/PTF/V1.0/data/SecurityTechnologyTaxonomy.json",
  "title":                "Security Technology Taxonomy V1.0",
  "description":          "SecurityTechnologyTaxonomy.",
  "type":                 "object",
  "additionalProperties": false,
  "properties":           {

    "Identity":           { "type": "array", "items": { "type": "string",
                            "enum": [ "PKI-X509",
                                      "DID-W3C",
                                      "VerifiableCredentials",
                                      "SPIFFE",
                                      "TPM-Identity",
                                      "SecureEnclave-Identity",
                                      "WebAuthn-FIDO2",
                                      "PSK-Identity",
                                      "Custom" ] } },

    "Authentication":     { "type": "array", "items": { "type": "string",
                            "enum": [ "mTLS",
                                      "OAuth2",
                                      "OpenID-Connect",
                                      "JWT-JWS",
                                      "Kerberos",
                                      "SASL",
                                      "HardwareSecurityKeys",
                                      "TPM-Attestation",
                                      "TEE-Attestation",
                                      "Custom" ] } },

    "Authorization":      { "type": "array", "items": { "type": "string",
                            "enum": [ "OAuth2-Scopes",
                                      "OPA-Rego",
                                      "XACML",
                                      "RBAC",
                                      "ABAC",
                                      "PBAC",
                                      "Microsegmentation",
                                      "ServiceMesh-Authorization",
                                      "Custom" ] } },

    "Integrity":          { "type": "array", "items": { "type": "string",
                            "enum": [ "SHA-256",
                                      "SHA-384",
                                      "SHA-512",
                                      "BLAKE3",
                                      "HMAC",
                                      "RSA-PSS",
                                      "ECDSA-P256",
                                      "Ed25519",
                                      "MerkleTree",
                                      "AEAD-Integrity",
                                      "Custom" ] } },

    "Confidentiality":    { "type": "array", "items": { "type": "string",
                            "enum": [ "TLS-1.3",
                                      "mTLS",
                                      "AES-256-GCM",
                                      "ChaCha20-Poly1305",
                                      "RSA-OAEP",
                                      "EndToEndEncryption",
                                      "TEE-ConfidentialCompute",
                                      "HomomorphicEncryption",
                                      "SMPC",
                                      "Custom" ] } },

    "FreshnessReplayProtection":  { "type": "array", "items": { "type": "string",
                                    "enum": [ "Nonces",
                                              "Timestamps",
                                              "MonotonicCounters",
                                              "SequenceNumbers",
                                              "AntiReplayWindows",
                                              "ChannelBinding",
                                              "Custom" ] } },

    "Attestation":        { "type": "array", "items": { "type": "string",
                            "enum": [ "TPM-RemoteAttestation",
                                      "TEE-SGX-Attestation",
                                      "TEE-SEV-Attestation",
                                      "TEE-TrustZone-Attestation",
                                      "RuntimeIntegrityChecks",
                                      "RemoteMeasurementProtocols",
                                      "Custom" ] } },

    "Auditability":       { "type": "array", "items": { "type": "string",
                            "enum": [ "TamperEvidentLogs",
                                      "WORM-Storage",
                                      "SignedLogging-RFC5848",
                                      "BlockchainLogging",
                                      "HashChainedLogs",
                                      "SIEM",
                                      "ForensicTimestamping",
                                      "Custom" ] } },

    "InfrastructureAbstraction": { "type": "array", "items": { "type": "string",
                                  "enum": [  "VM-Isolation",
                                            "ContainerIsolation",
                                            "ServiceMesh",
                                            "MicroVM",
                                            "TEE",
                                            "HypervisorIsolation",
                                            "Custom" ] } } } }
