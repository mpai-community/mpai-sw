{ "$id":                          "https://schemas.mpai.community/TFA/V1.5/data/LocationQualifier.json",
  "$schema":                      "https://json-schema.org/draft/2020-12/schema",

  "title":                        "LocationQualifier V1.5",
                                  "description": "Location categories, formats, and implementation-defined attributes.",
                                  "type": "object",
                                  "required": [ "Header", "LocationQualifierID", "SubTypes", "Formats" ],
                                  "additionalProperties": false, "properties": {

    "Header":                     { "type": "string", "const": "TFA-LCQ-V1.5" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "LocationQualifierID":        { "type": "string" },
    "LocationQualifierTime":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":                    { "type": "object", "additionalProperties": false, "properties": {
      "Categories":               { "type": "array", "items": { "type": "string", "enum": [ "Real", "Virtual" ] },
                                    "minItems": 1, "uniqueItems": true } } },

    "Formats":                     { "type": "object", "additionalProperties": false, "properties": {
      "MPAIContentFormat":        { "type": "object", "additionalProperties": false, "properties": {
        "SimpleLocation":         { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleLocation.json" },
        "Location":               { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/LocationObject.json" } } },
      "OtherContentFormats":      { "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/LocationContentFormats.json" } } },

    "Attributes":                 { "type": "object", "additionalProperties": true },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
