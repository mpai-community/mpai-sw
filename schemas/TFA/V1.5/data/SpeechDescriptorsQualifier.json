{ "$id":                              "https://schemas.mpai.community/TFA/V1.5/data/SpeechDescriptorsQualifier.json",
  "$schema":                          "https://json-schema.org/draft/2020-12/schema",
  "title":                            "Speech Descriptors Qualifier V1.5",
  "description":                      "Qualifier describing subtypes, formats, and attributes of speech descriptors.",
  "type":                             "object",
  "required":                         [ "Header", "SpeechDescriptorsQualifierID", "SubTypes", "Formats" ],
  "additionalProperties":             false,
  "properties":                       {

    "Header":                         { "type": "string", "const": "TFA-SDQ-V1.5" },
    "MInstanceID":                    { "type": "string" },
    "UEnvironmentID":                 { "type": "string" },
    "SpeechDescriptorsQualifierID":   { "type": "string" },
    "SpeechDescriptorsQualifierTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":                       { "type": "object", "additionalProperties": false },

    "Formats":                        { "type": "object", "additionalProperties": false, "properties": {
      "MPAISpeechDescriptorsFormat":  { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/BasicSpeechDescriptors.json" },
      "OtherSpeechDescriptorsFormats":{ "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/SpeechDescriptorsFormats.json" } } },

    "Attributes":                     { "type": "object", "additionalProperties": false },

    "DataXMData":                     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                  { "type": "string", "maxLength": 2048 } } }
