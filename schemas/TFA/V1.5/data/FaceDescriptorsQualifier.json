{ "$id":                             "https://schemas.mpai.community/TFA/V1.5/data/FaceDescriptorsQualifier.json",
  "$schema":                         "https://json-schema.org/draft/2020-12/schema",
  "title":                           "Face Descriptors Qualifier V1.5",
  "description":                     "Qualifier describing subtypes, format, and attributes of face descriptors.",
  "type":                            "object",
  "required":                        [ "Header", "FaceDescriptorsQualifierID", "SubTypes", "Formats" ],
  "additionalProperties":            false,
  "properties":                      {

    "Header":                        { "type": "string", "const": "TFA-FDQ-V1.5" },
    "MInstanceID":                   { "type": "string" },
    "UEnvironmentID":                { "type": "string" },
    "FaceDescriptorsQualifierID":    { "type": "string" },
    "FaceDescriptorsQualifierTime":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":                      { "type": "object", "additionalProperties": false },

    "Formats":                       { "type": "object", "additionalProperties": false, "properties": {
      "ContentFormat":               { "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/FaceDescriptorsContentFormats.json" } } },

    "Attributes":                    { "type": "object", "additionalProperties": false },

    "DataXMData":                    { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                 { "type": "string", "maxLength": 2048 } } }
