{ "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/TFA/V1.5/formats/EEGContentFormats.json",
  "title": "EEG Content Formats V1.5",
  "description": "Enumerates supported EEG/MEG content formats.",
  "type": "string",
  "oneOf": [
    { "const": "Minimum-EEG-MAT", "description": "Minimal MATLAB-based EEG format." },
    { "const": "Standard-EEG-MAT", "description": "Standard MATLAB-based EEG format." },
    { "const": "Minimum-MEG-MAT", "description": "Minimal MATLAB-based MEG format." },
    { "const": "Standard-MEG-MAT", "description": "Standard MATLAB-based MEG format." },
    { "const": "EDF", "description": "European Data Format for EEG signals." },
    { "const": "EDF+", "description": "EDF+ with annotations and extended metadata." },
    { "const": "BDF", "description": "BioSemi Data Format for EEG acquisition." },
    { "const": "BrainVision", "description": "BrainVision native format (.vhdr/.vmrk/.eeg)." },
    { "const": "GDF", "description": "BIOSIG General Data Format for biosignals." },
    { "const": "XDF", "description": "Extensible Data Format for multimodal recordings." },
    { "const": "EEGLAB", "description": "EEGLAB .set/.fdt format for EEG analysis." },
    { "const": "MNE-FIF", "description": "MNE FIF format for MEG/EEG data." },
    { "const": "CSV", "description": "Comma-separated values for tabular EEG exports." },
    { "const": "TSV", "description": "Tab-separated values for tabular EEG exports." },
    { "const": "JSON", "description": "JSON-based EEG metadata or data container." },
    { "const": "XML", "description": "XML-based EEG metadata or data container." },
    { "const": "HDF5", "description": "Hierarchical Data Format for large EEG datasets." } ] }

