{ "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mpai.community/TFA/V1.5/formats/ECGContentFormats.json",
  "title": "ECG Content Formats V1.5",
  "description": "Enumerates supported ECG content formats.",
  "type": "string",
  "oneOf": [
    { "const": "aECG", "description": "FDA annotated ECG format." },
    { "const": "DICOM-ECG", "description": "DICOM waveform encoding for ECG signals." },
    { "const": "ecgAware", "description": "Vendor-specific ECG format." },
    { "const": "ecgML", "description": "XML-based ECG markup language." },
    { "const": "HL7v2", "description": "HL7 Version 2 messaging for ECG data." },
    { "const": "HL7-FHIR-JSON", "description": "FHIR resources for ECG in JSON." },
    { "const": "HL7-FHIR-XML", "description": "FHIR resources for ECG in XML." },
    { "const": "mECGML", "description": "Modified ECGML format." },
    { "const": "MFER", "description": "Medical waveform format encoding rules." },
    { "const": "ML-ECG", "description": "Machine Learning ECG format." },
    { "const": "PhilipsXML", "description": "Philips proprietary XML ECG format." },
    { "const": "SCP-ECG", "description": "Standard Communications Protocol for ECG." },
    { "const": "OpenECG", "description": "Open ECG exchange format." },
    { "const": "ISO-IEEE-11073", "description": "ISO/IEEE standard for medical device communication." },
    { "const": "PDF-ECG", "description": "PDF-based ECG report format." },
    { "const": "CSV", "description": "Comma-separated values for ECG tabular data." },
    { "const": "TSV", "description": "Tab-separated values for ECG tabular data." },
    { "const": "EDF", "description": "European Data Format for biosignals." },
    { "const": "EDF+", "description": "EDF+ with annotations." },
    { "const": "JSON", "description": "Generic JSON ECG representation." },
    { "const": "XML", "description": "Generic XML ECG representation." } ] }

