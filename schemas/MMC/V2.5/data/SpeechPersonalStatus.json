{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/MMC/V2.5/data/SpeechPersonalStatus.json",
  "title":                    "Speech Personal Status V2.5",
  "description":              "Personal Status of the Speech modality: the Cognitive State, Emotion, and Social Attitude Factors carried by the speech. None is required; at least one shall be present.",
  "type":                     "object",
  "additionalProperties":     false,
  "required":                 [ "Header", "SpeechPersonalStatusID" ],
  "anyOf":                    [ { "required": [ "SpeechCognitiveState" ] },
                              { "required": [ "SpeechEmotion" ] },
                              { "required": [ "SpeechSocialAttitude" ] } ],
  "properties":               {

    "Header":                 { "type": "string", "const": "MMC-SPS-V2.5" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "SpeechPersonalStatusID":  { "type": "string" },
    "SpeechPersonalStatusTime":{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SpeechCognitiveState":    { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/CognitiveState.json" },
    "SpeechEmotion":           { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/Emotion.json" },
    "SpeechSocialAttitude":    { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/SocialAttitude.json" },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } } }
