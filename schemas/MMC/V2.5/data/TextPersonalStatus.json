{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/MMC/V2.5/data/TextPersonalStatus.json",
  "title":                    "Text Personal Status V2.5",
  "description":              "Personal Status of the Text modality: the Cognitive State, Emotion, and Social Attitude Factors carried by the text. None is required; at least one shall be present.",
  "type":                     "object",
  "additionalProperties":     false,
  "required":                 [ "Header", "TextPersonalStatusID" ],
  "anyOf":                    [ { "required": [ "TextCognitiveState" ] },
                              { "required": [ "TextEmotion" ] },
                              { "required": [ "TextSocialAttitude" ] } ],
  "properties":               {

    "Header":                 { "type": "string", "const": "MMC-TPS-V2.5" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "TextPersonalStatusID":  { "type": "string" },
    "TextPersonalStatusTime":{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "TextCognitiveState":    { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/CognitiveState.json" },
    "TextEmotion":           { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/Emotion.json" },
    "TextSocialAttitude":    { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/SocialAttitude.json" },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } } }
