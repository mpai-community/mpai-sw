{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/MMC/V2.5/data/GesturePersonalStatus.json",
  "title":                    "Gesture Personal Status V2.5",
  "description":              "Personal Status of the Gesture modality: the Cognitive State, Emotion, and Social Attitude Factors carried by the gesture. None is required; at least one shall be present.",
  "type":                     "object",
  "additionalProperties":     false,
  "required":                 [ "Header", "GesturePersonalStatusID" ],
  "anyOf":                    [ { "required": [ "GestureCognitiveState" ] },
                              { "required": [ "GestureEmotion" ] },
                              { "required": [ "GestureSocialAttitude" ] } ],
  "properties":               {

    "Header":                 { "type": "string", "const": "MMC-GPS-V2.5" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "GesturePersonalStatusID":  { "type": "string" },
    "GesturePersonalStatusTime":{ "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "GestureCognitiveState":    { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/CognitiveState.json" },
    "GestureEmotion":           { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/Emotion.json" },
    "GestureSocialAttitude":    { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/SocialAttitude.json" },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } } }
