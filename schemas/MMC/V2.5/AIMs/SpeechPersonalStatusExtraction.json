                          {"Output": {"AIMName": "", "DataType": "MMC-SDO-V2.5"}, "Input": {"AIMName": "MMC-PSI-V2.5", "DataType": "MMC-SDO-V2.5"}},
                          {"Output": {"AIMName": "MMC-PSI-V2.5", "DataType": "MMC-SPS-V2.5"}, "Input": {"AIMName": "", "DataType": "MMC-SPS-V2.5"}}],

