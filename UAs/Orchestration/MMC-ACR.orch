# =============================================================================
#  MMC-ACR.orch - Access Control Registration
#  Workflow Description Language, AIF V3.0
#
#  The User Agent never addresses a Module: it asks the Controller. See
#  HCI-MAD.orch for the mapping of each request onto the Controller API.
#
#  The user gives a name, a face and a voice; the Module computes the Face and
#  Speech Descriptors and writes them to the Subject Gallery in Shared Storage,
#  which MMC-MAC later reads. The writing is done by the Module's own AIMs -
#  Entity Face Description and Entity Speech Description - and the User Agent
#  neither performs nor witnesses it. It gives the name at a boundary Port and
#  receives the confirmation the Module renders.
#
#  MMC-ACR declares OSD-BTO twice - #1 the Response the avatar is to speak, #2
#  the name the descriptors are keyed by - and OSD-STM twice, #1 for the face
#  and #2 for the speech.
# =============================================================================

workflow MMC-ACR over MMC-ACR-V2.5

on Start:
    ask Controller to start MMC-ACR-V2.5

    prompt  "Welcome to the CAV Access Control Registration Service.
             Please type your name."
    type    UserName (OSD-BTO-V1.5)

    prompt  "Look at the camera."
    wait    1s
    acquire UserFace (OSD-BVO-V1.5)

    prompt  "Please speak a short sentence so I can learn your voice."
    acquire UserSpeech (OSD-BSO-V1.5) via VAD

    ask Controller to take UserFace       (OSD-BVO-V1.5)   for MMC-ACR-V2.5
    ask Controller to take UserFaceTime   (OSD-STM-V1.5:1) for MMC-ACR-V2.5
    ask Controller to take UserSpeech     (OSD-BSO-V1.5)   for MMC-ACR-V2.5
    ask Controller to take UserSpeechTime (OSD-STM-V1.5:2) for MMC-ACR-V2.5
    ask Controller to take UserName       (OSD-BTO-V1.5:2) for MMC-ACR-V2.5
    ask Controller to take Response       (OSD-BTO-V1.5:1) = "{UserName}, thank
        you for joining the Service. Speak your passphrase when you enter."
        for MMC-ACR-V2.5
    ask Controller to take Warmth         (MMC-EPS-V2.5)   for MMC-ACR-V2.5

    ask Controller to give from MMC-ACR-V2.5:
        VocalResponse (OSD-BSO-V1.5),
        MachineFace   (PAF-FDO-V1.6)
    present VocalResponse, MachineFace

on Stop:
    ask Controller to stop MMC-ACR-V2.5
