# =============================================================================
#  HCI-MAC.orch  -  User-Agent orchestration for the MMC-MAC Module
#
#  Workflow Description (WDL v0.1). Describes ONLY what the User Agent does:
#  real-world I/O (prompt/present/capture), timing (wait), and the boundary
#  exchange with the Controller (start / capture->module / await / stop).
#
#  The UA DRIVES the Module - through the Controller. The UA acts only on the
#  Controller (Start/Stop the Module, write boundary inputs, read boundary
#  outputs); it never touches a Module's AIMs. The Controller runs the Module's
#  AIMs and routes data among them BY DATA TYPE per the Module's L3
#  (1MMC-MAC-V2.5-I01.json). Chain of command: User <-> UserAgent -> Controller
#  -> AIMs -> Controller. This file names no AIM and no internal routing.
# =============================================================================

workflow HCI-MAC  over module MMC-MAC-V2.5
{
    start module MMC-MAC-V2.5

    prompt  "Welcome to the HCI Multimodal Access Control Service. Look at the camera."
    wait    1s
    capture FaceObject (OSD-BVO-V1.5) -> module
    #   FaceTime supplied from the UA clock as OSD-STM-V1.5 with the face.

    prompt  "Speak your passphrase."
    capture SpeechObject (OSD-BSO-V1.5) -> module
    #   SpeechTime supplied from the UA clock as OSD-STM-V1.5 with the speech.

    await   module outputs UserID          (OSD-IID-V1.5),
                           VocalResponse    (OSD-BSO-V1.5),
                           FaceDescriptors  (PAF-FDO-V1.6)

    branch on UserID {
        present VocalResponse
        present FaceDescriptors
        present "<name>, welcome."
    } else {
        present "I am sorry, you have not been identified."
    }

    stop module
}