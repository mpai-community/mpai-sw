<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MasService</AssemblyName>
    <OutputType>Exe</OutputType>
    <!-- Plain net10.0, not net10.0-windows: this half holds the models and is
         headed for a Linux host. AmqProvider supplies only ASR, TIQ, TTS, PSD
         and GFD - acquisition and delivery are the User Agent's, so no device
         project is referenced and nothing here is Windows-bound. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Mpai.Mas.Service</RootNamespace>
  </PropertyGroup>

  <!-- AmqApp's provider, COMPILED IN rather than referenced. It is internal to
       AmqApp, and linking the source leaves that file untouched: no change to a
       file the running application depends on, and one definition of which
       leaves MMC-AMQ has. -->
  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <!-- Framework -->
    <ProjectReference Include="..\..\..\AIF\Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\AIF\Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\AIF\Communication\GlobalStorage\AIF.GlobalStorage.csproj" />
    <ProjectReference Include="..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\AIMs\Providers\Mpai.Providers.csproj" />
    <!-- Controller API -->
    <ProjectReference Include="..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <!-- Zero Trust (M3223): the anchor, the Trace, a TPM-held key -->
    <ProjectReference Include="..\..\..\AIF\Trust\AIF.Trust.csproj" />
    <ProjectReference Include="..\..\..\AIF\RootOfTrust\AIF.RootOfTrust.csproj" />
    <!-- MAS -->
    <ProjectReference Include="..\..\Server\Mpai.Mas.Server.csproj" />

    <ProjectReference Include="..\..\..\AIF\PortData\Mpai.Aif.PortData.csproj" />
    <!-- MMC-AMQ leaves, plus the RSR leaves so the avatar can speak -->
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\ASR\Mpai.Mmc.Asr.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\TIQ\Mpai.Mmc.Tiq.csproj" />
    <ProjectReference Include="..\..\..\AIMs\MMC\V2.5\TTS\Mpai.Mmc.Tts.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\PSD\Mpai.Paf.Psd.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\GFD\Mpai.Paf.Gfd.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\GBD\Mpai.Paf.Gbd.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\SAS\Mpai.Paf.Sas.csproj" />
    <ProjectReference Include="..\..\..\AIMs\PAF\V1.6\SAR\Mpai.Paf.Sar.csproj" />
  </ItemGroup>

</Project>