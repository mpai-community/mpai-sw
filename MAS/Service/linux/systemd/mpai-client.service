# The browser client's host: the page people open, and the way to the MAS Service.
# Public, over HTTPS, with the certificate in /opt/mpai/tls.
[Unit]
Description=MPAI-MAS - the browser client
After=network.target mpai-service.service
Wants=mpai-service.service

[Service]
User=mpai
WorkingDirectory=/opt/mpai/client
Environment=ASPNETCORE_ENVIRONMENT=Production
# Where the MAS Service is on another machine: its bearer token, as MPAI_MAS_TOKEN=<token>
# in this file (readable by mpai only), and its address in --Service below. Absent here: ignored.
EnvironmentFile=-/opt/mpai/service-token.env
ExecStart=/opt/mpai/client/RcaWeb.Host --Service http://127.0.0.1:5005/ --Urls https://0.0.0.0:443 --Kestrel:Certificates:Default:Path=/opt/mpai/tls/cert.pem --Kestrel:Certificates:Default:KeyPath=/opt/mpai/tls/key.pem
# Port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure

[Install]
WantedBy=multi-user.target
