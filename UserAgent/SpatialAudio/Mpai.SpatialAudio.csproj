<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPATIAL AUDIO OF THE USER AGENT: what was Audio Object Delivery (CAE-AOD) until
       the author's decision of 2026/10/04, "AOD is UA's business". It renders an Audio
       Object or an Audio Scene as the User hears it, from the User Point of View (Steam
       Audio); the Loudspeaker Unit of the Physical Layer plays it. Portable (net10.0),
       so that a User Agent on any platform can use it. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AIMs\Core\Mpai.Core.csproj" />
  </ItemGroup>

</Project>
