<Project Sdk="Microsoft.NET.Sdk">

  <!-- RcaApp - a Remote Client Application with a face.
       The same interpreter as RcaConsole, with the stand-in devices replaced by
       the real ones: a microphone, a webcam and the avatar. It knows no
       application. Which Modules run, which Ports they take and which they give,
       all come from the Workflow Description it is given.

       IT HOLDS NO MODEL AND NO AIM. Acquisition and delivery are the User Agent's:
       the Units of its Physical Layer travel with it; everything that reasons stays
       on the Service (MPAI-AIF V3.0; enforced by UserAgentIsolationTests). -->

  <PropertyGroup>
    <AssemblyName>RcaApp</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DefineConstants>$(DefineConstants);WINDOWS_DEVICES</DefineConstants>
    <RootNamespace>MpaiRca</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Rca\Mpai.Rca.csproj" />
    <ProjectReference Include="..\..\..\Wdl\Mpai.Wdl.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\..\..\Remote\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\UaKit\Mpai.UaKit.csproj" />

    <!-- The devices: the Units of the Physical Layer. Nothing here reasons about
         what it captures. -->
    <ProjectReference Include="..\..\..\PhysicalLayer\Mpai.PhysicalLayer.csproj" />
  </ItemGroup>

</Project>