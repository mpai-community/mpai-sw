<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- SERVES THE BROWSER RCA. It hands the browser the client, the avatar page
       and MPAI-MAS, and passes /MPAI/AIFU/... on to the MPAI-MAS Service, so the
       browser talks to one origin only. The Service itself is not changed. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.*" />
    <ProjectReference Include="..\Client\RcaWeb.Client.csproj" />
  </ItemGroup>

</Project>
