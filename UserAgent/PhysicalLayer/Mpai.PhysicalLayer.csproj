<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE PHYSICAL LAYER OF THE USER AGENT (MPAI-AIF V3.0, User Agent 4): the
       Acquisition Units and Delivery Units that take data from, and deliver data to,
       the devices - microphone, camera, loudspeaker, avatar. They are not AIMs: they
       belong to the User Agent, and no Controller is involved in them. A User Agent
       reaches the real world only through them, and a Module only through the
       Controller API. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Mpai.PhysicalLayer</RootNamespace>
    <AssemblyName>Mpai.PhysicalLayer</AssemblyName>
  </PropertyGroup>

  <!-- The portable devices are a project of their own. -->
  <ItemGroup>
    <Compile Remove="Devices\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\SpatialAudio\Mpai.SpatialAudio.csproj" />
    <ProjectReference Include="Devices\Mpai.PhysicalLayer.Devices.csproj" />
  </ItemGroup>

</Project>
