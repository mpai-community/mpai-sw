<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mpai.Rca - executing a Workflow Description.
       Holds the interpreter and the table of which device a Data Type comes from.
       Knows no application: a workflow names its Modules, the registry names its
       devices, and neither is compiled in. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mpai.Rca</AssemblyName>
    <RootNamespace>Mpai.Rca</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wdl\Mpai.Wdl.csproj" />
    <ProjectReference Include="..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
  </ItemGroup>

</Project>