{ "Identifier":       {"ImplementerID": "1", "ImplementationID": "OSD-UID-V1.5-I01", "AIMName": "OSD-UID-V1.5"},

  "APIProfile":       "Basic",
  "Description":      "User Identification. Recognises a user from their face and their speech and reconciles the two into one answer. Speaker Identity Recognition matches the speech against the enrolled voices, Face Identity Recognition matches the face against the enrolled faces, and Identity Reconciliation combines the two hypotheses. Two outputs, because there are two questions: Identification states whether the presented face and speech match anybody held in Shared Storage, and User ID states which subject. A User Agent controlling access reads the first, one greeting a known person reads the second. The two modalities are treated alike throughout - each has its object, its time and its scene descriptors, and each is optional, so the Module answers from a face alone, a voice alone, or both. Enrolment is not this Module's business: it reads the gallery that MMC-ACR wrote. Acquisition is the User Agent's: the objects arrive at the boundary already captured.",

  "InternalTypes":   [{"Name": "FaceHypothesis",    "DataType": "OSD-IID-V1.5"},
                      {"Name": "SpeakerHypothesis", "DataType": "OSD-IID-V1.5"}],

