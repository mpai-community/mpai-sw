<Project Sdk="Microsoft.NET.Sdk">

  <!-- A PROVIDER BELONGS TO A MODULE, NOT TO A WINDOW. How a Module's AIMs are
       built is a fact about the Module: the same answer serves the application
       that runs it in process and the Service that runs it for a client.

       They lived inside the applications, so a Service wanting to offer three
       Apps had to reference three WPF executables - a Service depending on its
       clients, which is the wrong direction. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

