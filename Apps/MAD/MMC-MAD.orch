# =============================================================================
#  MMC-MAD.orch - MPAI Conversation Service
#  Workflow Description Language v0.3, AIF V3.0
#
#  One Controller, one Module. The User Agent offers the Controller data
#  identified by Data Type and Port Number, and asks for data identified the
#  same way. It names no AIM.
#
#  A step completes before the next begins.
# =============================================================================

workflow MMC-MAD over 1MMC-MAD-V2.5-I01

on Start:

    ask Controller to start

    # The Avatar this client holds and draws: every utterance animates it.
    acquire Avatar (PAF-AVT-V1.6)

    offer Welcome (OSD-BTO-V1.5:1) = "Welcome to the MPAI Conversation Service.
        Please wait a few seconds while the models load."
    offer Avatar (PAF-AVT-V1.6:1)
    ask   WelcomeSpeakingAvatar (XRV-SAV-V1.0)
    present WelcomeSpeakingAvatar

    offer Ready (OSD-BTO-V1.5:1) = "I am ready. Tell me what is on your mind."
    offer Avatar (PAF-AVT-V1.6:1)
    ask   ReadySpeakingAvatar (XRV-SAV-V1.0)
    present ReadySpeakingAvatar

    offer Farewell (OSD-BTO-V1.5:1) = "Thank you for the conversation. Goodbye."
    offer Avatar (PAF-AVT-V1.6:1)
    ask   FarewellSpeakingAvatar (XRV-SAV-V1.0)

    loop until Stop:

        acquire UserSpeech (OSD-BSO-V1.5) via VAD
             or UserText   (OSD-BTO-V1.5)
        branch on UserText {
            offer UserText (OSD-BTO-V1.5:2)
        } else {
            offer UserSpeech (OSD-BSO-V1.5:1)
        }
        offer Avatar (PAF-AVT-V1.6:1)
        ask   Memory (MMC-SUM-V2.5), MachineSpeakingAvatar (XRV-SAV-V1.0)
        present MachineSpeakingAvatar

        # The conversation's memory goes back with the next turn and nowhere
        # else: it starts empty with this conversation and ends with it.
        offer Memory (MMC-SUM-V2.5)

on Stop:

    present FarewellSpeakingAvatar

    ask Controller to stop